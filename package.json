  "repository": {
    "type": "git",
    "url": "git+https://github.com/LyraAgent/pi-apply-patch-universal.git"
  },
  "bugs": {
    "url": "https://github.com/LyraAgent/pi-apply-patch-universal/issues"
  },
  "homepage": "https://github.com/LyraAgent/pi-apply-patch-universal#readme",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
